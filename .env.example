# Deriv WebSocket credentials
# Use a demo token while validating this strategy.
DERIV_API_TOKEN=your_deriv_api_token_here
DERIV_APP_ID=129133

# Strategy symbol. Supported values: VOLATILITY_75, VOLATILITY_50
# Omit SYMBOL to trade all symbols in rules.json sequentially during loop mode.
# Do not use R_75/R_50 here; bot.js maps VOLATILITY_75/VOLATILITY_50 internally.
SYMBOL=VOLATILITY_75

# Risk overrides (optional — defaults come from rules.json)
# Leave MULTIPLIER unset for symbol defaults: VOLATILITY_75=50, VOLATILITY_50=80.
# If set, it must be valid for every active symbol.
# MULTIPLIER=50
# Deriv multiplier stake must be at least 1.00.
STAKE_USD=10
STOP_LOSS_USD=5
MAX_TRADES_PER_DAY=3

# Live safety gates. Dry-run ignores these and never places orders.
# ALLOW_REAL_TRADING=false
# DERIV_ALLOWED_REAL_LOGINID=
# TRADING_KILL_SWITCH=false
