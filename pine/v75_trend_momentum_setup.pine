//@version=6
indicator("V75 Trend Momentum Setup", overlay=true, max_labels_count=50, max_lines_count=50)

emaFastLen = input.int(50, "Fast EMA", minval=1)
emaSlowLen = input.int(200, "Slow EMA", minval=1)
rsiLen = input.int(14, "RSI Length", minval=1)
atrLen = input.int(14, "ATR Length", minval=1)
pivotLen = input.int(3, "Pivot Strength", minval=1)

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiValue = ta.rsi(close, rsiLen)
atrValue = ta.atr(atrLen)
[macdLine, macdSignal, _] = ta.macd(close, 12, 26, 9)

bullBias = close > emaSlow and emaFast > emaSlow
bearBias = close < emaSlow and emaFast < emaSlow
bullMomentum = rsiValue > 55 and macdLine > macdSignal
bearMomentum = rsiValue < 45 and macdLine < macdSignal

longSetup = bullBias and bullMomentum and close > emaFast
shortSetup = bearBias and bearMomentum and close < emaFast

plot(emaFast, "EMA 50", color=color.new(color.aqua, 0), linewidth=2)
plot(emaSlow, "EMA 200", color=color.new(color.orange, 0), linewidth=2)

plotshape(longSetup, title="Long setup", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="BUY")
plotshape(shortSetup, title="Short setup", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")

pivotHigh = ta.pivothigh(high, pivotLen, pivotLen)
pivotLow = ta.pivotlow(low, pivotLen, pivotLen)

var line resistanceLine = na
var line supportLine = na

if not na(pivotHigh)
    line.delete(resistanceLine)
    resistanceLine := line.new(bar_index - pivotLen, pivotHigh, bar_index, pivotHigh, extend=extend.right, color=color.red, width=2)

if not na(pivotLow)
    line.delete(supportLine)
    supportLine := line.new(bar_index - pivotLen, pivotLow, bar_index, pivotLow, extend=extend.right, color=color.lime, width=2)

atrStopLong = close - atrValue * 1.5
atrStopShort = close + atrValue * 1.5
plot(longSetup ? atrStopLong : na, "ATR Long Stop", color=color.new(color.lime, 25), style=plot.style_linebr)
plot(shortSetup ? atrStopShort : na, "ATR Short Stop", color=color.new(color.red, 25), style=plot.style_linebr)

var table status = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    biasText = bullBias ? "BULL" : bearBias ? "BEAR" : "RANGE"
    momentumText = bullMomentum ? "BULL" : bearMomentum ? "BEAR" : "NEUTRAL"
    table.cell(status, 0, 0, "Bias", text_color=color.white)
    table.cell(status, 1, 0, biasText, text_color=bullBias ? color.lime : bearBias ? color.red : color.yellow)
    table.cell(status, 0, 1, "Momentum", text_color=color.white)
    table.cell(status, 1, 1, momentumText, text_color=bullMomentum ? color.lime : bearMomentum ? color.red : color.yellow)
    table.cell(status, 0, 2, "RSI", text_color=color.white)
    table.cell(status, 1, 2, str.tostring(rsiValue, "#.0"), text_color=color.white)
    table.cell(status, 0, 3, "ATR", text_color=color.white)
    table.cell(status, 1, 3, str.tostring(atrValue, "#"), text_color=color.white)
    table.cell(status, 0, 4, "Rule", text_color=color.white)
    table.cell(status, 1, 4, "Trade with bias after pullback/breakout", text_color=color.white)
