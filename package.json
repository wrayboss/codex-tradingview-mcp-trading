{
  "name": "claude-tradingview-mcp-trading",
  "version": "2.0.0",
  "description": "Breakout + Retest trading bot - Claude + TradingView MCP + Deriv execution",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "trade": "node bot.js",
    "loop": "node bot.js --loop",
    "loop:dry": "node bot.js --loop --dry-run",
    "dry-run": "node bot.js --dry-run",
    "jarvis": "node scripts/jarvis.js",
    "runtime:health": "node scripts/runtime-health.js",
    "codex:autonomy": "node scripts/codex-autonomy.js",
    "codex:doctor": "node scripts/codex-doctor.js",
    "codex:mcp": "node codex-mcp/server.js",
    "codex:check": "node codex-mcp/server.js --self-test",
    "research:symbols": "node scripts/research-symbols.js",
    "research:candles": "node scripts/research-candles.js",
    "presentation:workbook": "node scripts/build-presentation-workbook.js",
    "test": "node tests/run-tests.js",
    "git:preflight": "node scripts/git-remote-preflight.js",
    "launch": "powershell -ExecutionPolicy Bypass -File launch.ps1",
    "validate-backtest": "node scripts/validate-backtest.js",
    "scan:secrets": "node scripts/scan-secrets.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "ws": "^8.20.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module"
}
